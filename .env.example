# ============================================================
#  Bill Splitter ZAR – Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=bill_splitter
POSTGRES_USER=bill_splitter
POSTGRES_PASSWORD=change_me_to_a_secure_password

# ── n8n ────────────────────────────────────────────────────
# WEBHOOK_URL must be the public-facing URL of your site.
# Cloudflare proxies HTTPS → your server HTTP:80 → nginx → n8n.
# n8n uses WEBHOOK_URL to build the full webhook URLs it registers.
# Use https:// because that is what Cloudflare presents to clients.
# Example: https://bills.yourdomain.com/
WEBHOOK_URL=https://YOUR_DOMAIN/

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_random_32_char_key_here!

# ── Ports (host-side, Docker) ──────────────────────────────
# nginx listens on HTTP_PORT. Put this behind Cloudflare (orange-cloud).
# Cloudflare handles HTTPS; nginx receives plain HTTP.
HTTP_PORT=80

# n8n admin UI port. Do NOT expose this via Cloudflare.
# Access it directly: http://YOUR_SERVER_IP:5678/
# Or restrict with a firewall rule once workflows are configured.
N8N_EXPOSED_PORT=5678
