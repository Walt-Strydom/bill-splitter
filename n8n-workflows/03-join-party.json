{
  "name": "03 – Join Party",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "join-party",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "a3b2c3d4-0003-0003-0003-000000000002"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, party_code, restaurant_name, tip_percent, status, currency, created_at\nFROM parties\nWHERE UPPER(party_code) = UPPER($1)\n  AND status = 'active'\nLIMIT 1",
        "options": {
          "queryReplacement": "={{ [($input.first().json.body || $input.first().json).party_code] }}"
        }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000003",
      "name": "Lookup Party",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [500, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000004",
      "name": "Party Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const party    = $input.first().json;\nconst body     = $('Webhook').first().json.body || $('Webhook').first().json;\n\n// Generate a secure join token\nconst arr = new Uint8Array(16);\ncrypto.getRandomValues(arr);\nconst joinToken = Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('');\n\nreturn [{\n  json: {\n    party_id:     party.id,\n    user_id:      body.user_id || null,\n    display_name: body.display_name || 'Guest',\n    join_token:   joinToken,\n    party:        party\n  }\n}];"
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000005",
      "name": "Prepare Guest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO guests (party_id, user_id, display_name, role, join_token)\nVALUES ($1::uuid, $2::uuid, $3, 'guest', $4)\nRETURNING id, party_id, user_id, display_name, role, join_token, status, created_at",
        "options": {
          "queryReplacement": "={{ [$json.party_id, $json.user_id, $json.display_name, $json.join_token] }}"
        }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000006",
      "name": "Insert Guest",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1250, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, unit_price_cents, total_quantity FROM items WHERE party_id = $1::uuid ORDER BY created_at",
        "options": {
          "queryReplacement": "={{ [$('Prepare Guest').first().json.party_id] }}"
        }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000007",
      "name": "Get Party Items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1500, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items   = $input.all().map(i => i.json);\nconst guest   = $('Insert Guest').first().json;\nconst prepared = $('Prepare Guest').first().json;\n\nreturn [{\n  json: {\n    party:    prepared.party,\n    guest: {\n      id:           guest.id,\n      display_name: guest.display_name,\n      role:         guest.role,\n      status:       guest.status,\n      join_token:   guest.join_token,\n      created_at:   guest.created_at\n    },\n    items\n  }\n}];"
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000008",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": { "responseCode": 200 }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000009",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"party_not_found\", \"message\": \"No active party found with that code\" }",
        "options": { "responseCode": 404 }
      },
      "id": "a3b2c3d4-0003-0003-0003-000000000010",
      "name": "Respond Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Lookup Party", "type": "main", "index": 0 }]
      ]
    },
    "Lookup Party": {
      "main": [
        [{ "node": "Party Found?", "type": "main", "index": 0 }]
      ]
    },
    "Party Found?": {
      "main": [
        [{ "node": "Prepare Guest", "type": "main", "index": 0 }],
        [{ "node": "Respond Not Found", "type": "main", "index": 0 }]
      ]
    },
    "Prepare Guest": {
      "main": [
        [{ "node": "Insert Guest", "type": "main", "index": 0 }]
      ]
    },
    "Insert Guest": {
      "main": [
        [{ "node": "Get Party Items", "type": "main", "index": 0 }]
      ]
    },
    "Get Party Items": {
      "main": [
        [{ "node": "Format Response", "type": "main", "index": 0 }]
      ]
    },
    "Format Response": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "a3b2c3d4-0003-0003-0003-000000000000",
  "meta": { "templateCredsSetupCompleted": true },
