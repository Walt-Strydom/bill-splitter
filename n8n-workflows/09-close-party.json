{
  "name": "09 – Close Party",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "close-party",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "a9b2c3d4-0009-0009-0009-000000000002"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.id AS guest_id, g.party_id, g.role\nFROM guests g\nJOIN parties p ON p.id = g.party_id\nWHERE g.join_token = $1\n  AND g.role = 'host'\n  AND g.status = 'closed'\n  AND p.status = 'active'\nLIMIT 1",
        "options": {
          "queryReplacement": "={{ [($input.first().json.body || $input.first().json).join_token] }}"
        }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000003",
      "name": "Validate Host",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [500, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.guest_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000004",
      "name": "Host Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS total_guests,\n       COUNT(*) FILTER (WHERE status = 'closed') AS closed_guests\nFROM guests\nWHERE party_id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$('Validate Host').first().json.party_id] }}"
        }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000005",
      "name": "Check All Guests Closed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1000, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.total_guests }}",
              "rightValue": "={{ $json.closed_guests }}",
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000006",
      "name": "All Closed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE parties SET status = 'closed' WHERE id = $1::uuid RETURNING id, party_code, status",
        "options": {
          "queryReplacement": "={{ [$('Validate Host').first().json.party_id] }}"
        }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000007",
      "name": "Close Party",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1500, 100],
      "credentials": {
        "postgres": {
          "id": "postgres-credential-id",
          "name": "Bill Splitter Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, party_id: $json.id, party_code: $json.party_code, status: $json.status }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000008",
      "name": "Respond Closed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1750, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"guests_not_closed\", \"message\": \"Cannot close party: not all guests have closed their tab\" }",
        "options": { "responseCode": 409 }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000009",
      "name": "Respond Guests Still Open",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"unauthorized\", \"message\": \"Invalid host token, host must close their own tab first\" }",
        "options": { "responseCode": 403 }
      },
      "id": "a9b2c3d4-0009-0009-0009-000000000010",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Validate Host", "type": "main", "index": 0 }]
      ]
    },
    "Validate Host": {
      "main": [
        [{ "node": "Host Valid?", "type": "main", "index": 0 }]
      ]
    },
    "Host Valid?": {
      "main": [
        [{ "node": "Check All Guests Closed", "type": "main", "index": 0 }],
        [{ "node": "Respond Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Check All Guests Closed": {
      "main": [
        [{ "node": "All Closed?", "type": "main", "index": 0 }]
      ]
    },
    "All Closed?": {
      "main": [
        [{ "node": "Close Party", "type": "main", "index": 0 }],
        [{ "node": "Respond Guests Still Open", "type": "main", "index": 0 }]
      ]
    },
    "Close Party": {
      "main": [
        [{ "node": "Respond Closed", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "a9b2c3d4-0009-0009-0009-000000000000",
  "meta": { "templateCredsSetupCompleted": true },
  "id": "workflow-close-party",
  "tags": [{ "name": "bill-splitter" }]
}
